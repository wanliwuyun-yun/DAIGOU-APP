<view class="page-publish-demand">
  <view class="form container">
    <view class="form-group">
      <text class="form-label">商品名称 <text class="required">*</text></text>
      <input class="form-input" placeholder="请输入想要代购的商品名称" value="{{form.productName}}" bindinput="onInput" data-field="productName" maxlength="100" />
    </view>

    <view class="form-group">
      <text class="form-label">商品链接</text>
      <input class="form-input" placeholder="如有商品链接可粘贴（选填）" value="{{form.productLink}}" bindinput="onInput" data-field="productLink" />
    </view>

    <view class="form-group">
      <text class="form-label">商品图片</text>
      <view class="image-upload">
        <view class="image-item" wx:for="{{form.images}}" wx:key="*this">
          <image class="upload-img" src="{{item}}" mode="aspectFill" />
          <view class="image-remove" data-index="{{index}}" bindtap="removeImage">X</view>
        </view>
        <view class="image-add" bindtap="addImage" wx:if="{{form.images.length < 9}}">
          <text class="add-icon">+</text>
          <text class="add-text">添加图片</text>
        </view>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">代购地区 <text class="required">*</text></text>
      <picker mode="multiSelector" range="{{regionPicker}}" range-key="name" value="{{regionPickerValue}}" bindchange="onRegionPick" bindcolumnchange="onRegionColumnChange">
        <view class="form-picker {{form.region ? '' : 'placeholder'}}">
          {{form.regionName || '请选择代购地区'}}
        </view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">商品分类 <text class="required">*</text></text>
      <view class="category-picker">
        <text class="cat-pick-item {{form.category === item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onCategoryPick">
          {{item.icon}} {{item.name}}
        </text>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">预算（元）<text class="required">*</text></text>
      <input class="form-input" type="digit" placeholder="请输入预算金额，0表示面议" value="{{form.budget}}" bindinput="onInput" data-field="budget" />
    </view>

    <view class="form-group">
      <text class="form-label">数量</text>
      <view class="stepper">
        <view class="stepper-btn" bindtap="changeQty" data-delta="-1">-</view>
        <input class="stepper-input" type="number" value="{{form.quantity}}" bindinput="onInput" data-field="quantity" />
        <view class="stepper-btn" bindtap="changeQty" data-delta="1">+</view>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">期望到货时间</text>
      <picker mode="date" start="{{today}}" value="{{form.expectTime}}" bindchange="onInput" data-field="expectTime">
        <view class="form-picker {{form.expectTime ? '' : 'placeholder'}}">
          {{form.expectTime || '请选择期望到货时间'}}
        </view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">是否接受拼单</text>
      <view class="switch-row">
        <text class="switch-desc">{{form.allowGroupBuy ? '接受拼单，可降低运费' : '不接受拼单'}}</text>
        <switch checked="{{form.allowGroupBuy}}" bindchange="onSwitch" data-field="allowGroupBuy" color="#E8734A" />
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">备注要求</text>
      <textarea class="form-textarea" placeholder="填写特殊要求，如颜色、尺码、款式等" value="{{form.note}}" bindinput="onInput" data-field="note" maxlength="500" auto-height />
      <text class="form-count">{{form.note.length}}/500</text>
    </view>

    <view class="prohibited-tip">
      <text class="tip-icon">!</text>
      <text class="tip-text">禁止代购违禁品，详见</text>
      <text class="tip-link" bindtap="goNotice">代购须知</text>
    </view>

    <view class="submit-area safe-bottom">
      <button class="btn btn-primary btn-block btn-lg" bindtap="submitForm" loading="{{submitting}}">发布需求</button>
    </view>
  </view>
</view>