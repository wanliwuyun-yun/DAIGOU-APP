<!-- wxml -->
<view class="page-settings">
  <view class="menu-section" wx:if="{{isLoggedIn}}">
    <view class="menu-item" bindtap="bindPhone">
      <text class="menu-icon">📱</text>
      <text class="menu-text">绑定手机号</text>
      <text class="menu-extra text-muted">{{phoneText}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">👤</text>
      <text class="menu-text">头像昵称</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="clearCache">
      <text class="menu-icon">🗑️</text>
      <text class="menu-text">清除缓存</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="login-area" wx:if="{{!isLoggedIn}}">
    <button class="btn btn-primary btn-block btn-lg" open-type="getUserInfo" bindgetuserinfo="onGetUserInfo">微信登录</button>
    <button class="btn btn-outline btn-block" style="margin-top:16rpx;" open-type="getPhoneNumber" bindgetphonenumber="onGetPhone">绑定手机号（选填）</button>
  </view>
</view>