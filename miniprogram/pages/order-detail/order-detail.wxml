<view class="page-order-detail">
  <!-- 状态 -->
  <view class="status-header" style="background:{{order.statusColor}}10;">
    <text class="status-text" style="color:{{order.statusColor}};">{{order.statusText}}</text>
    <text class="status-desc">{{order.statusDesc}}</text>
  </view>

  <view class="detail-body container">
    <!-- 商品信息 -->
    <view class="card" style="padding:28rpx;">
      <text class="card-title">商品信息</text>
      <view class="order-body">
        <image class="order-img" src="{{order.productImages[0] || '/images/placeholder.png'}}" mode="aspectFill" />
        <view class="order-info">
          <text class="order-name">{{order.productName}}</text>
          <text class="order-region text-muted">{{order.regionName}} · {{order.categoryName}}</text>
          <text class="order-qty text-muted">x{{order.quantity || 1}}</text>
        </view>
      </view>
    </view>

    <!-- 费用明细 -->
    <view class="card" style="padding:28rpx;">
      <text class="card-title">费用明细</text>
      <view class="fee-row">
        <text class="fee-label">商品价格</text>
        <text class="fee-value">¥{{order.price || order.budget || 0}}</text>
      </view>
      <view class="fee-row" wx:if="{{order.serviceFee}}">
        <text class="fee-label">代购服务费</text>
        <text class="fee-value">¥{{order.serviceFee}}</text>
      </view>
      <view class="divider"></view>
      <view class="fee-row">
        <text class="fee-label" style="font-weight:700;">合计</text>
        <text class="price"><text class="price-symbol">¥</text><text class="price-value">{{order.totalAmount || order.budget || 0}}</text></text>
      </view>
    </view>

    <!-- 双方信息 -->
    <view class="card" style="padding:28rpx;">
      <text class="card-title">交易双方</text>
      <view class="party-row">
        <text class="party-label text-muted">买家</text>
        <text class="party-name">{{order.buyerName}}</text>
      </view>
      <view class="party-row">
        <text class="party-label text-muted">代购者</text>
        <text class="party-name">{{order.daigouName}}</text>
      </view>
    </view>

    <!-- 订单信息 -->
    <view class="card" style="padding:28rpx;">
      <text class="card-title">订单信息</text>
      <view class="fee-row"><text class="fee-label text-muted">订单号</text><text class="fee-value" style="font-size:24rpx;">{{order.orderId}}</text></view>
      <view class="fee-row"><text class="fee-label text-muted">下单时间</text><text class="fee-value" style="font-size:24rpx;">{{order.createdAtStr}}</text></view>
      <view class="fee-row" wx:if="{{order.shippingNote}}"><text class="fee-label text-muted">运费说明</text><text class="fee-value" style="font-size:24rpx;">{{order.shippingNote}}</text></view>
    </view>
  </view>

  <view style="height:160rpx;"></view>

  <!-- 底部操作 -->
  <view class="bottom-bar safe-bottom" wx:if="{{canOperate}}">
    <button class="btn btn-outline" style="flex:1;" bindtap="cancelOrder" wx:if="{{order.status === 'intention' || order.status === 'pending'}}">取消订单</button>
    <button class="btn btn-primary" style="flex:1;" bindtap="openChat">联系对方</button>

    <!-- 代购者操作：推进状态 -->
    <button class="btn btn-primary" style="flex:1;" bindtap="nextStatus" wx:if="{{isDaigou && order.status !== 'completed' && order.status !== 'cancelled'}}">
      {{nextStatusText}}
    </button>

    <!-- 完成后评价 -->
    <button class="btn btn-accent" style="flex:1;" bindtap="goReview" wx:if="{{order.status === 'completed' && !order.reviewed}}">
      评价
    </button>
  </view>
</view>