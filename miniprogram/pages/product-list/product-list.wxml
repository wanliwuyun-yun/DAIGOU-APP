<!-- 商品列表页 -->
<view class="page-product-list">
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <region-nav activeId="{{currentRegion}}" bind:change="onRegionChange" wx:if="{{!regionName}}" />
    <view class="filter-current" wx:else>
      <text class="filter-current-text">{{regionName || '全部地区'}}</text>
      <text class="filter-clear" bindtap="clearRegion">✕ 清除筛选</text>
    </view>
  </view>

  <!-- 品类筛选 -->
  <scroll-view class="category-filter" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{!categoryName}}">
    <view class="category-filter-inner">
      <text class="cat-filter-item {{currentCategory === 'all' ? 'active' : ''}}" data-id="all" bindtap="onCategoryChange">全部</text>
      <text class="cat-filter-item {{currentCategory === item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="onCategoryChange">{{item.icon}} {{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 排序 -->
  <view class="sort-bar">
    <text class="sort-item {{sort === 'default' ? 'active' : ''}}" data-sort="default" bindtap="onSortChange">综合</text>
    <text class="sort-item {{sort === 'priceAsc' ? 'active' : ''}}" data-sort="priceAsc" bindtap="onSortChange">价格↑</text>
    <text class="sort-item {{sort === 'priceDesc' ? 'active' : ''}}" data-sort="priceDesc" bindtap="onSortChange">价格↓</text>
    <text class="sort-item {{sort === 'newest' ? 'active' : ''}}" data-sort="newest" bindtap="onSortChange">最新</text>
  </view>

  <!-- 商品瀑布流 -->
  <view class="product-waterfall container" wx:if="{{products.length > 0}}">
    <view class="waterfall-col">
      <product-card wx:for="{{productsLeft}}" wx:key="_id" item="{{item}}" />
    </view>
    <view class="waterfall-col">
      <product-card wx:for="{{productsRight}}" wx:key="_id" item="{{item}}" />
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{products.length === 0 && !loading}}">
    <text class="empty-icon">📦</text>
    <text class="empty-title">暂无可代购商品</text>
    <text class="empty-desc">换个地区或品类看看吧</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{products.length > 0}}">
    <text class="text-muted" wx:if="{{loading}}">加载中...</text>
    <text class="text-muted" wx:elif="{{noMore}}">- 没有更多了 -</text>
  </view>

  <view style="height:60rpx;"></view>
</view>