<view class="page-product-detail">
  <!-- 图片轮播 -->
  <swiper class="img-swiper" indicator-dots indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#FFF" circular autoplay>
    <swiper-item wx:for="{{product.images}}" wx:key="*this">
      <image class="swiper-img" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-src="{{item}}" />
    </swiper-item>
  </swiper>

  <view class="detail-main">
    <!-- 价格 -->
    <view class="price-row">
      <view class="price">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{product.price}}</text>
      </view>
      <text class="service-fee" wx:if="{{product.serviceFee}}">+服务费¥{{product.serviceFee}}</text>
      <text class="stock-tag tag {{product.stockType === '现货' ? 'tag-success' : 'tag-warning'}}" style="margin-left:auto;">{{product.stockType}}</text>
    </view>

    <!-- 名称 -->
    <text class="product-name">{{product.name}}</text>

    <!-- 标签 -->
    <view class="tag-row">
      <text class="tag tag-primary">{{product.regionName}}</text>
      <text class="tag" style="background:var(--bg);color:var(--text-secondary);">{{product.categoryName}}</text>
      <text class="tag" style="background:var(--bg);color:var(--text-secondary);" wx:if="{{product.limitCount > 0}}">限购{{product.limitCount}}件</text>
    </view>

    <view class="divider"></view>

    <!-- 代购者信息 -->
    <view class="daigou-row" bindtap="goDaigou">
      <image class="avatar avatar-sm" src="{{product.daigouAvatar || '/images/avatar-default.png'}}" mode="aspectFill" />
      <text class="daigou-name">{{product.daigouName || '代购达人'}}</text>
      <text class="daigou-go">查看主页 ›</text>
    </view>

    <view class="divider"></view>

    <!-- 详情信息 -->
    <view class="info-list">
      <view class="info-item" wx:if="{{product.shippingNote}}">
        <text class="info-label">运费说明</text>
        <text class="info-value">{{product.shippingNote}}</text>
      </view>
      <view class="info-item" wx:if="{{product.deliveryTime}}">
        <text class="info-label">发货时效</text>
        <text class="info-value">{{product.deliveryTime}}</text>
      </view>
    </view>

    <view class="divider"></view>

    <!-- 商品详情 -->
    <view class="detail-content">
      <text class="detail-title">商品详情</text>
      <text class="detail-text">{{product.detail || '暂无详情'}}</text>
    </view>
  </view>

  <view style="height:140rpx;"></view>

  <!-- 底部操作 -->
  <view class="bottom-bar safe-bottom">
    <button class="btn btn-ghost" bindtap="openChat">私信咨询</button>
    <button class="btn btn-primary" style="flex:2;" bindtap="createOrder">下单代购</button>
  </view>
</view>