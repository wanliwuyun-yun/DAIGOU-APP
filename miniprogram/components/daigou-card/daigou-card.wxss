.daigou-card {
  padding: 28rpx;
}

.daigou-main {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.daigou-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.daigou-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--success);
  color: #FFFFFF;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFFFFF;
}

.daigou-info {
  flex: 1;
  min-width: 0;
}

.daigou-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.daigou-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.daigou-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.daigou-regions {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.daigou-stats {
  display: flex;
  align-items: center;
  background: var(--bg);
  border-radius: var(--radius);
  padding: 20rpx 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--primary);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: var(--border);
}