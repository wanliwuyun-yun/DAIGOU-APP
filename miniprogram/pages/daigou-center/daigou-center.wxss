.page-daigou-center { min-height: 100vh; background: var(--bg); }
.stats-overview { margin: 24rpx 32rpx; }
.overview-title { display: block; font-size: 30rpx; font-weight: 700; margin-bottom: 24rpx; }
.stats-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 16rpx; }
.stats-cell { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.stats-num { font-size: 36rpx; font-weight: 800; color: var(--primary); }
.stats-label { font-size: 22rpx; color: var(--text-muted); }
.menu-section { margin: 24rpx 32rpx; background: var(--card); border-radius: var(--radius-lg); box-shadow: var(--shadow); overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 32rpx 28rpx; border-bottom: 2rpx solid var(--border-light); }
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-text { flex: 1; font-size: 28rpx; }
.menu-arrow { font-size: 32rpx; color: var(--text-muted); }