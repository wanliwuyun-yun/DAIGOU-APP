.page-daigou-detail { min-height: 100vh; background: var(--bg); padding-bottom: 140rpx; }

.profile-header {
  background: linear-gradient(135deg, var(--secondary), var(--secondary-light));
  padding: 60rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.daigou-name { font-size: 36rpx; font-weight: 800; color: #FFFFFF; }

.daigou-badges { display: flex; gap: 12rpx; }

.daigou-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  text-align: center;
  margin-top: 8rpx;
  line-height: 1.6;
  max-width: 80%;
}

.stats-row {
  display: flex;
  margin: -32rpx 32rpx 24rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  padding: 32rpx 0;
  position: relative;
  z-index: 10;
}

.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.stat-value { font-size: 36rpx; font-weight: 800; color: var(--primary); }
.stat-label { font-size: 22rpx; color: var(--text-muted); }
.stat-divider { width: 2rpx; height: 56rpx; background: var(--border); }

.section { padding: 24rpx 32rpx 0; }
.section-title { display: block; font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; }
.region-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }

.product-waterfall { display: flex; gap: 20rpx; }
.waterfall-col { flex: 1; display: flex; flex-direction: column; gap: 20rpx; }
.empty-hint { text-align: center; padding: 32rpx 0; }

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
}