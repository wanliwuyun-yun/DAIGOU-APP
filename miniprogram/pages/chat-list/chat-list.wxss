.page-chat-list { min-height: 100vh; background: var(--bg); }

.chat-list { padding: 16rpx 0; }

.chat-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid var(--border-light);
  transition: background 0.2s;
}
.chat-item:active { background: var(--bg); }

.chat-avatar-wrap { position: relative; flex-shrink: 0; }

.unread-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--danger);
  border: 4rpx solid #FFFFFF;
}

.chat-info { flex: 1; min-width: 0; }

.chat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.chat-name { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.chat-time { font-size: 22rpx; }

.chat-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chat-last-msg { flex: 1; font-size: 24rpx; color: var(--text-muted); margin-right: 16rpx; }

.unread-badge {
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: var(--danger);
  color: #FFFFFF;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  flex-shrink: 0;
}