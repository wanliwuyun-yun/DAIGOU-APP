.page-chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-warm);
}

.msg-scroll { flex: 1; }

.msg-list { padding: 20rpx 24rpx; }

.msg-time {
  text-align: center;
  padding: 16rpx 0;
}

.msg-time text {
  font-size: 22rpx;
  color: var(--text-muted);
  background: rgba(0,0,0,0.04);
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
}

.msg-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.msg-me { flex-direction: row-reverse; }

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--border-light);
  flex-shrink: 0;
}

.msg-content { max-width: 65%; }

.msg-bubble {
  background: #FFFFFF;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  box-shadow: var(--shadow-sm);
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-primary);
}

.msg-me .msg-bubble {
  background: var(--primary);
  color: #FFFFFF;
}

.msg-image {
  max-width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 输入栏 */
.input-bar {
  background: #FFFFFF;
  border-top: 2rpx solid var(--border-light);
}

.input-bar-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
}

.input-icon { font-size: 40rpx; padding: 8rpx; flex-shrink: 0; }

.chat-input {
  flex: 1;
  height: 72rpx;
  background: var(--bg);
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.send-btn {
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 36rpx;
  background: var(--border);
  color: var(--text-muted);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
}

.send-btn.active {
  background: var(--primary);
  color: #FFFFFF;
}