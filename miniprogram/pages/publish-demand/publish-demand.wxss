.page-publish-demand { min-height: 100vh; background: var(--bg); padding-bottom: 160rpx; }

.form { padding-top: 24rpx; }

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.required { color: var(--danger); }

.form-input {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  border-radius: var(--radius);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-shadow: var(--shadow-sm);
}

.form-picker {
  height: 88rpx;
  background: #FFFFFF;
  border-radius: var(--radius);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-sm);
}

.form-picker.placeholder { color: var(--text-muted); }

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #FFFFFF;
  border-radius: var(--radius);
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-shadow: var(--shadow-sm);
  line-height: 1.6;
}

.form-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

/* 图片上传 */
.image-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius);
  overflow: hidden;
}

.upload-img { width: 100%; height: 100%; }

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius);
  border: 4rpx dashed var(--border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #FFFFFF;
}

.add-icon { font-size: 48rpx; color: var(--text-muted); }
.add-text { font-size: 22rpx; color: var(--text-muted); }

/* 品类选择 */
.category-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cat-pick-item {
  padding: 12rpx 20rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: #FFFFFF;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}

.cat-pick-item.active {
  background: var(--primary);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(232, 115, 74, 0.3);
}

/* 步进器 */
.stepper {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  width: 240rpx;
}

.stepper-btn {
  width: 80rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text-primary);
  background: var(--bg);
}

.stepper-input {
  flex: 1;
  height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-primary);
}

/* 开关 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: var(--radius);
  padding: 20rpx 28rpx;
  box-shadow: var(--shadow-sm);
}

.switch-desc { font-size: 26rpx; color: var(--text-secondary); }

/* 违禁品提示 */
.prohibited-tip {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 149, 0, 0.06);
  border-radius: var(--radius);
  margin-bottom: 32rpx;
}

.tip-icon { font-size: 28rpx; }
.tip-text { font-size: 22rpx; color: var(--text-secondary); flex: 1; }
.tip-link { font-size: 22rpx; color: var(--primary); font-weight: 600; }

/* 提交 */
.submit-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
}