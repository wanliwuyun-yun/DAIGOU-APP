.page-index {
  min-height: 100vh;
  background: var(--bg);
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--secondary);
}

.nav-inner {
  padding: 12rpx 32rpx 20rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 36rpx;
  padding: 0 28rpx;
}

.search-icon { font-size: 28rpx; }
.search-placeholder { font-size: 26rpx; color: rgba(255,255,255,0.5); }

/* 轮播 */
.banner-swiper {
  height: 320rpx;
  margin: 0 32rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-top: 16rpx;
}

.banner-item {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  padding: 0 48rpx;
}

.banner-content {
  position: relative;
  z-index: 2;
}

.banner-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.banner-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 28rpx;
}

.banner-btn {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 32rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 30rpx;
  backdrop-filter: blur(10px);
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.banner-deco {
  position: absolute;
  right: -40rpx;
  top: 50%;
  transform: translateY(-50%);
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.15);
}
.c1 { width: 300rpx; height: 300rpx; right: 0; top: -150rpx; }
.c2 { width: 200rpx; height: 200rpx; right: 60rpx; top: -100rpx; }
.c3 { width: 120rpx; height: 120rpx; right: 20rpx; top: -60rpx; }

/* 通用区块 */
.section {
  padding: 32rpx 32rpx 0;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.section-more {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 地区分类 */
.region-scroll { white-space: nowrap; }

.region-grid {
  display: inline-flex;
  gap: 20rpx;
}

.region-grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 140rpx;
  flex-shrink: 0;
}

.region-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
}

.region-grid-item:active .region-icon-wrap {
  transform: scale(0.92);
}

.region-emoji { font-size: 40rpx; }
.region-text { font-size: 22rpx; color: var(--text-primary); font-weight: 600; white-space: nowrap; }
.region-count { font-size: 18rpx; color: var(--text-muted); }

/* 品类网格 */
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 0;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s ease;
}

.category-item:active { transform: scale(0.92); }
.category-icon { font-size: 40rpx; }
.category-name { font-size: 22rpx; color: var(--text-secondary); font-weight: 500; }

/* 代购达人横向滚动 */
.daigou-scroll { white-space: nowrap; }

.daigou-scroll-inner {
  display: inline-flex;
  gap: 20rpx;
}

.daigou-mini-card {
  width: 200rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.daigou-mini-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--border-light);
}

.daigou-mini-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  max-width: 168rpx;
}

.daigou-mini-region {
  font-size: 20rpx;
  color: var(--text-muted);
  max-width: 168rpx;
}

.daigou-mini-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

/* 需求迷你列表 */
.demand-mini-list {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.demand-mini-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  transition: background 0.2s;
}

.demand-mini-item:active { background: var(--bg); }

.demand-mini-left {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
}

.demand-mini-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.demand-mini-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.demand-mini-time { font-size: 22rpx; }

.demand-mini-right { flex-shrink: 0; }

/* 瀑布流 */
.product-waterfall {
  display: flex;
  gap: 20rpx;
}

.waterfall-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.load-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
}

.empty-hint {
  text-align: center;
  padding: 48rpx 0;
  font-size: 26rpx;
}

/* 发布弹出 */
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
}

.sheet-close {
  font-size: 32rpx;
  color: var(--text-muted);
  padding: 8rpx;
}

.sheet-body {
  padding: 16rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sheet-option {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  background: var(--bg);
  border-radius: var(--radius);
  transition: transform 0.2s;
}

.sheet-option:active { transform: scale(0.98); }

.sheet-option-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.sheet-option-info {
  flex: 1;
}

.sheet-option-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.sheet-option-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
}