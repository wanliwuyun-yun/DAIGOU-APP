.page-daigou-apply { min-height: 100vh; background: var(--bg); padding-bottom: 160rpx; }
.intro-card { margin-bottom: 32rpx; }
.intro-title { display: block; font-size: 32rpx; font-weight: 800; margin-bottom: 12rpx; }
.intro-desc { font-size: 26rpx; color: var(--text-secondary); line-height: 1.6; }

.form-group { margin-bottom: 32rpx; }
.form-label { display: block; font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.required { color: var(--danger); }
.form-input { width: 100%; height: 88rpx; background: #FFFFFF; border-radius: var(--radius); padding: 0 28rpx; font-size: 28rpx; box-shadow: var(--shadow-sm); }
.form-textarea { width: 100%; min-height: 160rpx; background: #FFFFFF; border-radius: var(--radius); padding: 24rpx 28rpx; font-size: 28rpx; box-shadow: var(--shadow-sm); line-height: 1.6; }

.region-select { display: flex; flex-direction: column; gap: 20rpx; }
.region-group-name { display: block; font-size: 26rpx; font-weight: 600; color: var(--text-primary); margin-bottom: 10rpx; }
.region-options { display: flex; flex-wrap: wrap; gap: 12rpx; }
.region-opt { padding: 10rpx 20rpx; border-radius: 28rpx; font-size: 24rpx; color: var(--text-secondary); background: #FFFFFF; box-shadow: var(--shadow-sm); }
.region-opt.active { background: var(--primary); color: #FFFFFF; }

.cat-select { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cat-opt { padding: 10rpx 20rpx; border-radius: 28rpx; font-size: 24rpx; color: var(--text-secondary); background: #FFFFFF; box-shadow: var(--shadow-sm); }
.cat-opt.active { background: var(--primary); color: #FFFFFF; }

.submit-area { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 32rpx; background: #FFFFFF; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05); }