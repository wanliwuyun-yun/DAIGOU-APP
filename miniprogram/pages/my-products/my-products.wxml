<!-- wxml -->
<view class="page-my-products">
  <view class="tab-bar">
    <text class="tab-item {{tab==='all'?'active':''}}" data-tab="all" bindtap="switchTab">全部</text>
    <text class="tab-item {{tab==='上架'?'active':''}}" data-tab="上架" bindtap="switchTab">上架中</text>
    <text class="tab-item {{tab==='下架'?'active':''}}" data-tab="下架" bindtap="switchTab">已下架</text>
  </view>
  <view class="product-list container">
    <view class="my-product-card card" wx:for="{{list}}" wx:key="_id">
      <image class="my-product-img" src="{{item.images[0] || '/images/placeholder.png'}}" mode="aspectFill" bindtap="goDetail" data-id="{{item._id}}" />
      <view class="my-product-info">
        <text class="my-product-name text-ellipsis" bindtap="goDetail" data-id="{{item._id}}">{{item.name}}</text>
        <text class="price" style="font-size:28rpx;">¥{{item.price}}</text>
        <text class="tag {{item.status==='上架'?'tag-success':'tag-danger'}}" style="font-size:20rpx;">{{item.status}}</text>
      </view>
      <view class="my-product-actions">
        <text class="action-btn" bindtap="toggleStatus" data-id="{{item._id}}" data-status="{{item.status}}">{{item.status === '上架' ? '下架' : '上架'}}</text>
        <text class="action-btn" bindtap="editProduct" data-id="{{item._id}}">编辑</text>
      </view>
    </view>
  </view>
  <view class="empty-state" wx:if="{{list.length===0}}"><text class="empty-icon">🛍️</text><text class="empty-title">暂无商品</text></view>
</view>