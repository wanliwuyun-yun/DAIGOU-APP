<view class="page-chat-list">
  <view class="empty-state" wx:if="{{!isLoggedIn}}">
    <text class="empty-icon">💬</text>
    <text class="empty-title">请先登录</text>
    <button class="btn btn-primary btn-sm" style="margin-top:24rpx;" bindtap="goLogin">去登录</button>
  </view>

  <view class="empty-state" wx:elif="{{chatList.length === 0}}">
    <text class="empty-icon">💬</text>
    <text class="empty-title">暂无消息</text>
    <text class="empty-desc">去首页找代购达人聊聊吧</text>
  </view>

  <view class="chat-list" wx:else>
    <view class="chat-item" wx:for="{{chatList}}" wx:key="_id" data-chat="{{item}}" bindtap="openChat">
      <view class="chat-avatar-wrap">
        <image class="avatar" src="{{item.targetAvatar || '/images/avatar-default.png'}}" mode="aspectFill" />
        <view class="unread-dot" wx:if="{{item.unreadCount > 0}}"></view>
      </view>
      <view class="chat-info">
        <view class="chat-top">
          <text class="chat-name">{{item.targetName || '用户'}}</text>
          <text class="chat-time text-muted">{{item.lastTimeAgo}}</text>
        </view>
        <view class="chat-bottom">
          <text class="chat-last-msg text-ellipsis">{{item.lastMessage || '暂无消息'}}</text>
          <text class="unread-badge" wx:if="{{item.unreadCount > 0}}">{{item.unreadCount > 99 ? '99+' : item.unreadCount}}</text>
        </view>
      </view>
    </view>
  </view>
</view>