.product-card {
  width: 100%;
}

.product-image-wrap {
  position: relative;
  width: 100%;
  padding-top: 100%;
  overflow: hidden;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.product-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.product-tag-top {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  z-index: 2;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  height: 78rpx;
  color: var(--text-primary);
}

.product-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.product-category {
  font-size: 22rpx;
  color: var(--text-muted);
}

.product-bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
}

.product-service-fee {
  font-size: 22rpx;
  color: var(--text-muted);
}