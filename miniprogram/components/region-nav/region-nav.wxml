<!-- 地区导航组件 -->
<scroll-view class="region-nav" scroll-x enhanced show-scrollbar="{{false}}">
  <view class="region-nav-inner">
    <view 
      class="region-item {{activeId === 'all' ? 'active' : ''}}"
      data-id="all"
      bindtap="onTap"
    >
      <text class="region-icon">🌍</text>
      <text class="region-name">全部</text>
    </view>
    <view 
      wx:for="{{regions}}" 
      wx:key="id"
      class="region-item {{activeId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTap"
    >
      <text class="region-icon">{{item.icon}}</text>
      <text class="region-name">{{item.name}}</text>
    </view>
  </view>
</scroll-view>