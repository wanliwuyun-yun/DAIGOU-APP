/* wxss */
.page-settings { min-height: 100vh; background: var(--bg); }
.menu-section { margin: 24rpx 32rpx; background: var(--card); border-radius: var(--radius-lg); box-shadow: var(--shadow); overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 32rpx 28rpx; border-bottom: 2rpx solid var(--border-light); }
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-text { flex: 1; font-size: 28rpx; }
.menu-extra { font-size: 24rpx; margin-right: 16rpx; }
.menu-arrow { font-size: 32rpx; color: var(--text-muted); }
.login-area { padding: 60rpx 32rpx; }