<view class="page-profile">
  <!-- 未登录状态 -->
  <view class="login-card" wx:if="{{!isLoggedIn}}" bindtap="goLogin">
    <view class="login-avatar">
      <text class="login-avatar-icon">👤</text>
    </view>
    <text class="login-text">点击登录 / 注册</text>
    <text class="login-desc">登录后享受完整代购服务</text>
  </view>

  <!-- 已登录状态 -->
  <view class="user-card" wx:else>
    <view class="user-info-row">
      <image class="avatar avatar-xl" src="{{userInfo.avatarUrl || '/images/avatar-default.png'}}" mode="aspectFill" />
      <view class="user-info-text">
        <text class="user-name">{{userInfo.nickName || '用户'}}</text>
        <view class="user-role-row">
          <text class="tag tag-primary" wx:if="{{isBuyer}}">买家</text>
          <text class="tag tag-accent" wx:if="{{isDaigou}}">代购达人</text>
          <text class="tag" style="background:rgba(255,59,48,0.1);color:#FF3B30;" wx:if="{{userInfo.applyStatus === 'pending'}}">审核中</text>
        </view>
      </view>
      <text class="user-arrow" bindtap="goSettings">⚙️</text>
    </view>
    <!-- 手机号 -->
    <view class="user-phone" wx:if="{{userInfo.phone}}">
      <text class="text-muted">已绑定手机：{{userInfo.phone.slice(0,3)}}****{{userInfo.phone.slice(7)}}</text>
    </view>
  </view>

  <!-- 代购入口 -->
  <view class="daigou-entry card" wx:if="{{isLoggedIn && !isDaigou && userInfo.applyStatus !== 'pending'}}" bindtap="goApply">
    <view class="daigou-entry-left">
      <text class="daigou-entry-icon">⭐</text>
      <view class="daigou-entry-info">
        <text class="daigou-entry-title">申请成为代购达人</text>
        <text class="daigou-entry-desc">开通代购身份，接单赚取服务费</text>
      </view>
    </view>
    <text class="daigou-entry-arrow">›</text>
  </view>

  <!-- 审核中提示 -->
  <view class="daigou-entry card" wx:if="{{isLoggedIn && userInfo.applyStatus === 'pending'}}">
    <view class="daigou-entry-left">
      <text class="daigou-entry-icon">⏳</text>
      <view class="daigou-entry-info">
        <text class="daigou-entry-title">代购申请审核中</text>
        <text class="daigou-entry-desc">请耐心等待管理员审核</text>
      </view>
    </view>
  </view>

  <!-- 代购管理中心入口 -->
  <view class="daigou-entry card" wx:if="{{isDaigou}}" bindtap="goDaigouCenter">
    <view class="daigou-entry-left">
      <text class="daigou-entry-icon">🏪</text>
      <view class="daigou-entry-info">
        <text class="daigou-entry-title">代购管理中心</text>
        <text class="daigou-entry-desc">管理商品、接单、收益</text>
      </view>
    </view>
    <text class="daigou-entry-arrow">›</text>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goMyDemands">
      <text class="menu-icon">📋</text>
      <text class="menu-text">我的需求</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMyOrders">
      <text class="menu-icon">📦</text>
      <text class="menu-text">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goFavorites">
      <text class="menu-icon">❤️</text>
      <text class="menu-text">收藏的达人</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goNotice">
      <text class="menu-icon">📖</text>
      <text class="menu-text">代购须知</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAgreement">
      <text class="menu-icon">📄</text>
      <text class="menu-text">用户协议与隐私政策</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-area" wx:if="{{isLoggedIn}}">
    <button class="btn btn-outline btn-block" bindtap="logout">退出登录</button>
  </view>
  <view style="height:120rpx;"></view>
</view>